{
  "name": "ulrischa/pure-php-wms",
  "description": "Pure PHP WMS: configuration-driven WMS 1.3 server using GD and indexed local geodata",
  "license": "GPL-3.0-or-later",
  "type": "project",
  "require": {
    "php": "^8.2",
    "phpmyadmin/shapefile": "^4.0.1",
    "proj4php/proj4php": "^2.0",
    "halaxa/json-machine": "^1.2",
    "ext-gd": "*",
    "ext-pdo_sqlite": "*",
    "ext-xmlwriter": "*",
    "ext-mbstring": "*",
    "ext-iconv": "*"
  },
  "autoload": {
    "psr-4": {
      "PureWms\\": "src/"
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "test": "@php tests/run.php"
  },
  "homepage": "https://github.com/ulrischa/pure-php-wms"
}
